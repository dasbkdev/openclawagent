{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "PowerShell(*)",
      "Bash(*)"
    ],
    "deny": [
      "Read(**/secrets.json)",
      "Read(**/secrets.key)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/admin-credentials.txt)",
      "Read(kickidler/**)"
    ]
  }
}
