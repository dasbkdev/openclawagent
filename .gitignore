# Local/proprietary checkouts. Do not push these into the deployment repo.
kickidler/
metricon/
Metricon/

# Upstream checkout. Clone/manage it separately unless intentionally added as a submodule.
openclaw/

# Runtime state and secrets.
**/.env
**/.env.*
!**/.env.example
**/data/
**/dist/
**/node_modules/
**/secrets.json
**/secrets.key
**/runtime-config.json
**/*.log

# Large generated desktop installers are deployed to the server/download storage,
# not committed into Git history.
control-plane/public/downloads/*.exe
control-plane/public/downloads/*.dmg
control-plane/public/downloads/*.deb
