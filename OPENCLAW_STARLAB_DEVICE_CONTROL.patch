diff --git a/apps/macos/Sources/OpenClaw/StarlabAgentClient.swift b/apps/macos/Sources/OpenClaw/StarlabAgentClient.swift
new file mode 100644
index 0000000000..1fa7d6e3cd
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/StarlabAgentClient.swift
@@ -0,0 +1,474 @@
+import AppKit
+import Foundation
+import SwiftUI
+
+private let starlabDefaultBaseURL = "https://starlabagent.pp.ua"
+private let starlabConfigKey = "starlab.agent.config.v1"
+private let starlabCommandPollNanoseconds: UInt64 = 5_000_000_000
+private let starlabDeviceCapabilities = [
+    "heartbeat",
+    "openclaw-macos",
+    "chat",
+    "command-polling",
+    "open_app",
+    "close_app",
+    "open_url",
+    "open_file",
+    "list_running_apps",
+    "active_window",
+    "screenshot",
+    "clipboard_get",
+    "clipboard_set",
+    "keyboard_type",
+    "hotkey",
+    "mouse_click",
+]
+
+struct StarlabAgentUser: Codable, Equatable {
+    var id: String
+    var displayName: String
+    var role: String
+    var employeeId: String?
+}
+
+struct StarlabAgentDevice: Codable, Equatable {
+    var deviceId: String
+    var displayName: String?
+    var status: String?
+    var lastSeenAt: String?
+    var heartbeatCount: Int?
+}
+
+struct StarlabAgentConfig: Codable, Equatable {
+    var activated: Bool
+    var controlPlaneURL: String
+    var user: StarlabAgentUser?
+    var agent: StarlabAgentDevice?
+    var deviceToken: String?
+    var activatedAt: String?
+    var lastHeartbeatAt: String?
+    var lastHeartbeatError: String?
+    var lastCommandAt: String?
+    var lastCommandError: String?
+}
+
+struct StarlabEnvelope<T: Codable>: Codable {
+    var ok: Bool
+    var data: T?
+    var error: StarlabAPIError?
+}
+
+struct StarlabAPIError: Codable {
+    var message: String
+}
+
+struct StarlabActivationData: Codable {
+    var user: StarlabAgentUser
+    var agent: StarlabAgentDevice
+    var deviceToken: String
+}
+
+struct StarlabChatData: Codable {
+    var answer: String
+}
+
+struct StarlabHeartbeatData: Codable {
+    var agent: StarlabAgentDevice
+    var created: Bool?
+}
+
+enum StarlabJSONValue: Codable, Equatable {
+    case string(String)
+    case number(Double)
+    case bool(Bool)
+    case object([String: StarlabJSONValue])
+    case array([StarlabJSONValue])
+    case null
+
+    init(from decoder: Decoder) throws {
+        let container = try decoder.singleValueContainer()
+        if container.decodeNil() {
+            self = .null
+        } else if let value = try? container.decode(Bool.self) {
+            self = .bool(value)
+        } else if let value = try? container.decode(Double.self) {
+            self = .number(value)
+        } else if let value = try? container.decode(String.self) {
+            self = .string(value)
+        } else if let value = try? container.decode([StarlabJSONValue].self) {
+            self = .array(value)
+        } else {
+            self = .object(try container.decode([String: StarlabJSONValue].self))
+        }
+    }
+
+    func encode(to encoder: Encoder) throws {
+        var container = encoder.singleValueContainer()
+        switch self {
+        case .string(let value):
+            try container.encode(value)
+        case .number(let value):
+            try container.encode(value)
+        case .bool(let value):
+            try container.encode(value)
+        case .object(let value):
+            try container.encode(value)
+        case .array(let value):
+            try container.encode(value)
+        case .null:
+            try container.encodeNil()
+        }
+    }
+
+    var stringValue: String? {
+        switch self {
+        case .string(let value):
+            return value
+        case .number(let value):
+            return String(value)
+        case .bool(let value):
+            return value ? "true" : "false"
+        default:
+            return nil
+        }
+    }
+
+    var doubleValue: Double? {
+        switch self {
+        case .number(let value):
+            return value
+        case .string(let value):
+            return Double(value)
+        default:
+            return nil
+        }
+    }
+
+    var boolValue: Bool? {
+        switch self {
+        case .bool(let value):
+            return value
+        case .string(let value):
+            return ["1", "true", "yes"].contains(value.lowercased())
+        default:
+            return nil
+        }
+    }
+}
+
+struct StarlabDeviceCommand: Codable, Equatable, Identifiable {
+    var id: String
+    var deviceId: String
+    var userId: String
+    var type: String
+    var args: [String: StarlabJSONValue]?
+}
+
+struct StarlabDeviceCommandsData: Codable {
+    var commands: [StarlabDeviceCommand]
+}
+
+struct StarlabDeviceCommandResultData: Codable {
+    var command: StarlabDeviceCommand?
+}
+
+@MainActor
+final class StarlabAgentClient: ObservableObject {
+    static let shared = StarlabAgentClient()
+    static let defaultControlPlaneURL = starlabDefaultBaseURL
+
+    @Published private(set) var config: StarlabAgentConfig
+
+    private var heartbeatTask: Task<Void, Never>?
+    private var commandTask: Task<Void, Never>?
+
+    private init() {
+        self.config = Self.loadConfig()
+    }
+
+    var isActivated: Bool {
+        self.config.activated && self.config.user != nil && self.config.agent != nil && self.config.deviceToken != nil
+    }
+
+    func activate(registrationCode: String, controlPlaneURL: String = starlabDefaultBaseURL) async throws {
+        let baseURL = Self.normalizedBaseURL(controlPlaneURL)
+        let body: [String: Any] = [
+            "registrationCode": registrationCode.trimmingCharacters(in: .whitespacesAndNewlines),
+            "deviceId": Self.defaultDeviceID(),
+            "displayName": Self.defaultDisplayName(),
+            "hostname": Host.current().localizedName ?? ProcessInfo.processInfo.hostName,
+            "platform": "darwin",
+            "arch": Self.architectureName(),
+            "osRelease": ProcessInfo.processInfo.operatingSystemVersionString,
+            "agentVersion": Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "0.1.0",
+            "capabilities": starlabDeviceCapabilities,
+        ]
+        let response: StarlabEnvelope<StarlabActivationData> = try await Self.postJSON(
+            url: "\(baseURL)/api/v1/device-agents/activate",
+            body: body,
+            headers: [:])
+        guard response.ok, let data = response.data else {
+            throw NSError(
+                domain: "StarlabAgent",
+                code: 1,
+                userInfo: [NSLocalizedDescriptionKey: response.error?.message ?? "Activation failed"])
+        }
+        let next = StarlabAgentConfig(
+            activated: true,
+            controlPlaneURL: baseURL,
+            user: data.user,
+            agent: data.agent,
+            deviceToken: data.deviceToken,
+            activatedAt: ISO8601DateFormatter().string(from: Date()),
+            lastHeartbeatAt: nil,
+            lastHeartbeatError: nil,
+            lastCommandAt: nil,
+            lastCommandError: nil)
+        self.config = next
+        Self.saveConfig(next)
+        self.startHeartbeat()
+        self.startCommandPolling()
+    }
+
+    func reset() {
+        UserDefaults.standard.removeObject(forKey: starlabConfigKey)
+        self.config = Self.loadConfig()
+        self.heartbeatTask?.cancel()
+        self.heartbeatTask = nil
+        self.commandTask?.cancel()
+        self.commandTask = nil
+    }
+
+    func startHeartbeat() {
+        self.heartbeatTask?.cancel()
+        guard self.isActivated else { return }
+        self.heartbeatTask = Task { [weak self] in
+            while !Task.isCancelled {
+                await self?.sendHeartbeatAndStore()
+                try? await Task.sleep(nanoseconds: 60_000_000_000)
+            }
+        }
+    }
+
+    func startCommandPolling() {
+        self.commandTask?.cancel()
+        guard self.isActivated else { return }
+        self.commandTask = Task { [weak self] in
+            while !Task.isCancelled {
+                await self?.pollDeviceCommandsAndStore()
+                try? await Task.sleep(nanoseconds: starlabCommandPollNanoseconds)
+            }
+        }
+    }
+
+    func ask(_ text: String) async throws -> String {
+        guard let agent = self.config.agent, let token = self.config.deviceToken else {
+            throw NSError(domain: "StarlabAgent", code: 2, userInfo: [NSLocalizedDescriptionKey: "Agent is not activated"])
+        }
+        let response: StarlabEnvelope<StarlabChatData> = try await Self.postJSON(
+            url: "\(self.config.controlPlaneURL)/api/v1/local-agent/chat",
+            body: [
+                "deviceId": agent.deviceId,
+                "text": text,
+            ],
+            headers: ["X-Device-Agent-Token": token])
+        guard response.ok, let data = response.data else {
+            throw NSError(
+                domain: "StarlabAgent",
+                code: 3,
+                userInfo: [NSLocalizedDescriptionKey: response.error?.message ?? "Assistant request failed"])
+        }
+        return data.answer
+    }
+
+    private func sendHeartbeatAndStore() async {
+        do {
+            let updated = try await self.sendHeartbeat()
+            var next = self.config
+            next.agent = updated.agent
+            next.lastHeartbeatAt = ISO8601DateFormatter().string(from: Date())
+            next.lastHeartbeatError = nil
+            self.config = next
+            Self.saveConfig(next)
+        } catch {
+            var next = self.config
+            next.lastHeartbeatError = error.localizedDescription
+            self.config = next
+            Self.saveConfig(next)
+        }
+    }
+
+    private func sendHeartbeat() async throws -> StarlabHeartbeatData {
+        guard let user = self.config.user, let agent = self.config.agent, let token = self.config.deviceToken else {
+            throw NSError(domain: "StarlabAgent", code: 4, userInfo: [NSLocalizedDescriptionKey: "Agent is not activated"])
+        }
+        let response: StarlabEnvelope<StarlabHeartbeatData> = try await Self.postJSON(
+            url: "\(self.config.controlPlaneURL)/api/v1/device-agents/heartbeat",
+            body: [
+                "userId": user.id,
+                "deviceId": agent.deviceId,
+                "displayName": agent.displayName ?? Self.defaultDisplayName(),
+                "hostname": Host.current().localizedName ?? ProcessInfo.processInfo.hostName,
+                "platform": "darwin",
+                "arch": Self.architectureName(),
+                "osRelease": ProcessInfo.processInfo.operatingSystemVersionString,
+                "agentVersion": Bundle.main.infoDictionary?["CFBundleShortVersionString"] as? String ?? "0.1.0",
+                "capabilities": starlabDeviceCapabilities,
+            ],
+            headers: ["X-Device-Agent-Token": token])
+        guard response.ok, let data = response.data else {
+            throw NSError(
+                domain: "StarlabAgent",
+                code: 5,
+                userInfo: [NSLocalizedDescriptionKey: response.error?.message ?? "Heartbeat failed"])
+        }
+        return data
+    }
+
+    private func pollDeviceCommandsAndStore() async {
+        do {
+            let executed = try await self.pollDeviceCommands()
+            var next = self.config
+            if executed > 0 {
+                next.lastCommandAt = ISO8601DateFormatter().string(from: Date())
+            }
+            next.lastCommandError = nil
+            self.config = next
+            Self.saveConfig(next)
+        } catch {
+            var next = self.config
+            next.lastCommandError = error.localizedDescription
+            self.config = next
+            Self.saveConfig(next)
+        }
+    }
+
+    private func pollDeviceCommands() async throws -> Int {
+        guard let agent = self.config.agent, let token = self.config.deviceToken else {
+            return 0
+        }
+        let response: StarlabEnvelope<StarlabDeviceCommandsData> = try await Self.getJSON(
+            url: "\(self.config.controlPlaneURL)/api/v1/device-agents/commands?deviceId=\(Self.urlQuery(agent.deviceId))&limit=5",
+            headers: ["X-Device-Agent-Token": token])
+        guard response.ok, let data = response.data else {
+            throw NSError(
+                domain: "StarlabAgent",
+                code: 20,
+                userInfo: [NSLocalizedDescriptionKey: response.error?.message ?? "Command polling failed"])
+        }
+
+        for command in data.commands {
+            let execution = await StarlabDeviceCommandExecutor.execute(command)
+            let errorValue: Any = execution.error ?? NSNull()
+            let _: StarlabEnvelope<StarlabDeviceCommandResultData> = try await Self.postJSON(
+                url: "\(self.config.controlPlaneURL)/api/v1/device-agents/commands/\(Self.urlPath(command.id))/result",
+                body: [
+                    "deviceId": agent.deviceId,
+                    "status": execution.status,
+                    "result": execution.result,
+                    "error": errorValue,
+                ],
+                headers: ["X-Device-Agent-Token": token])
+        }
+        return data.commands.count
+    }
+
+    private static func loadConfig() -> StarlabAgentConfig {
+        guard let data = UserDefaults.standard.data(forKey: starlabConfigKey),
+              let decoded = try? JSONDecoder().decode(StarlabAgentConfig.self, from: data)
+        else {
+            return StarlabAgentConfig(
+                activated: false,
+                controlPlaneURL: starlabDefaultBaseURL,
+                user: nil,
+                agent: nil,
+                deviceToken: nil,
+                activatedAt: nil,
+                lastHeartbeatAt: nil,
+                lastHeartbeatError: nil,
+                lastCommandAt: nil,
+                lastCommandError: nil)
+        }
+        return decoded
+    }
+
+    private static func saveConfig(_ config: StarlabAgentConfig) {
+        if let data = try? JSONEncoder().encode(config) {
+            UserDefaults.standard.set(data, forKey: starlabConfigKey)
+        }
+    }
+
+    private static func postJSON<T: Codable>(url: String, body: [String: Any], headers: [String: String]) async throws -> T {
+        guard let endpoint = URL(string: url) else {
+            throw NSError(domain: "StarlabAgent", code: 10, userInfo: [NSLocalizedDescriptionKey: "Invalid URL: \(url)"])
+        }
+        var request = URLRequest(url: endpoint)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        for (key, value) in headers {
+            request.setValue(value, forHTTPHeaderField: key)
+        }
+        request.httpBody = try JSONSerialization.data(withJSONObject: body, options: [])
+        let (data, response) = try await URLSession.shared.data(for: request)
+        if let http = response as? HTTPURLResponse, !(200..<300).contains(http.statusCode) {
+            if let decoded = try? JSONDecoder().decode(T.self, from: data) {
+                return decoded
+            }
+            throw NSError(domain: "StarlabAgent", code: http.statusCode, userInfo: [NSLocalizedDescriptionKey: "HTTP \(http.statusCode)"])
+        }
+        return try JSONDecoder().decode(T.self, from: data)
+    }
+
+    private static func getJSON<T: Codable>(url: String, headers: [String: String]) async throws -> T {
+        guard let endpoint = URL(string: url) else {
+            throw NSError(domain: "StarlabAgent", code: 11, userInfo: [NSLocalizedDescriptionKey: "Invalid URL: \(url)"])
+        }
+        var request = URLRequest(url: endpoint)
+        request.httpMethod = "GET"
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        for (key, value) in headers {
+            request.setValue(value, forHTTPHeaderField: key)
+        }
+        let (data, response) = try await URLSession.shared.data(for: request)
+        if let http = response as? HTTPURLResponse, !(200..<300).contains(http.statusCode) {
+            if let decoded = try? JSONDecoder().decode(T.self, from: data) {
+                return decoded
+            }
+            throw NSError(domain: "StarlabAgent", code: http.statusCode, userInfo: [NSLocalizedDescriptionKey: "HTTP \(http.statusCode)"])
+        }
+        return try JSONDecoder().decode(T.self, from: data)
+    }
+
+    private static func normalizedBaseURL(_ value: String) -> String {
+        let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+        return (trimmed.isEmpty ? starlabDefaultBaseURL : trimmed).trimmingCharacters(in: CharacterSet(charactersIn: "/"))
+    }
+
+    private static func defaultDeviceID() -> String {
+        let raw = "\(NSUserName())-\(ProcessInfo.processInfo.hostName)"
+        return raw.lowercased().replacingOccurrences(of: #"[^a-z0-9._-]+"#, with: "-", options: .regularExpression)
+    }
+
+    private static func defaultDisplayName() -> String {
+        "\(NSUserName()) on \(Host.current().localizedName ?? ProcessInfo.processInfo.hostName)"
+    }
+
+    private static func urlQuery(_ value: String) -> String {
+        value.addingPercentEncoding(withAllowedCharacters: .urlQueryAllowed) ?? value
+    }
+
+    private static func urlPath(_ value: String) -> String {
+        value.addingPercentEncoding(withAllowedCharacters: .urlPathAllowed) ?? value
+    }
+
+    private static func architectureName() -> String {
+        #if arch(arm64)
+        return "arm64"
+        #elseif arch(x86_64)
+        return "x64"
+        #else
+        return "unknown"
+        #endif
+    }
+}
diff --git a/apps/macos/Sources/OpenClaw/StarlabAgentWindow.swift b/apps/macos/Sources/OpenClaw/StarlabAgentWindow.swift
new file mode 100644
index 0000000000..e85f36c97a
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/StarlabAgentWindow.swift
@@ -0,0 +1,330 @@
+import AppKit
+import SwiftUI
+
+@MainActor
+final class StarlabAgentWindowController {
+    static let shared = StarlabAgentWindowController()
+
+    private var window: NSWindow?
+
+    func show() {
+        if let window {
+            DockIconManager.shared.temporarilyShowDock()
+            window.makeKeyAndOrderFront(nil)
+            NSApp.activate(ignoringOtherApps: true)
+            return
+        }
+
+        let hosting = NSHostingController(rootView: StarlabAgentWindowView())
+        let window = NSWindow(contentViewController: hosting)
+        window.title = "Starlab OpenClaw Agent"
+        window.setContentSize(NSSize(width: 720, height: 680))
+        window.styleMask = [.titled, .closable, .miniaturizable, .resizable, .fullSizeContentView]
+        window.titlebarAppearsTransparent = true
+        window.titleVisibility = .hidden
+        window.isMovableByWindowBackground = true
+        window.isReleasedWhenClosed = false
+        window.center()
+        DockIconManager.shared.temporarilyShowDock()
+        window.makeKeyAndOrderFront(nil)
+        NSApp.activate(ignoringOtherApps: true)
+        self.window = window
+    }
+
+    func showIfNeeded() {
+        if !StarlabAgentClient.shared.isActivated {
+            self.show()
+        }
+    }
+}
+
+private struct StarlabChatMessage: Identifiable, Equatable {
+    enum Sender: Equatable {
+        case user
+        case assistant
+    }
+
+    let id = UUID()
+    let sender: Sender
+    let text: String
+}
+
+struct StarlabAgentWindowView: View {
+    @ObservedObject private var client = StarlabAgentClient.shared
+    @State private var controlPlaneURL = StarlabAgentClient.defaultControlPlaneURL
+    @State private var registrationCode = ""
+    @State private var isActivating = false
+    @State private var activationError: String?
+    @State private var draft = ""
+    @State private var isSending = false
+    @State private var chatError: String?
+    @State private var messages: [StarlabChatMessage] = [
+        StarlabChatMessage(
+            sender: .assistant,
+            text: "Я локальный OpenClaw-агент Starlab. После регистрации я работаю с тем же сервером и памятью, что Telegram-бот."),
+    ]
+
+    var body: some View {
+        VStack(spacing: 0) {
+            self.header
+            Divider()
+            if self.client.isActivated {
+                self.chatView
+            } else {
+                self.activationView
+            }
+        }
+        .frame(minWidth: 640, minHeight: 560)
+        .background(Color(nsColor: .windowBackgroundColor))
+        .onAppear {
+            self.controlPlaneURL = self.client.config.controlPlaneURL
+        }
+    }
+
+    private var header: some View {
+        HStack(alignment: .center, spacing: 14) {
+            ZStack {
+                RoundedRectangle(cornerRadius: 12)
+                    .fill(self.client.isActivated ? Color.green.opacity(0.14) : Color.blue.opacity(0.14))
+                Image(systemName: self.client.isActivated ? "checkmark.seal.fill" : "person.badge.key.fill")
+                    .font(.system(size: 24, weight: .semibold))
+                    .foregroundStyle(self.client.isActivated ? .green : .blue)
+            }
+            .frame(width: 48, height: 48)
+
+            VStack(alignment: .leading, spacing: 4) {
+                Text("Starlab OpenClaw Agent")
+                    .font(.title2.weight(.semibold))
+                Text(self.headerSubtitle)
+                    .font(.callout)
+                    .foregroundStyle(.secondary)
+                    .lineLimit(2)
+            }
+            Spacer(minLength: 12)
+            if self.client.isActivated {
+                self.connectionBadge
+            }
+        }
+        .padding(.horizontal, 26)
+        .padding(.top, 24)
+        .padding(.bottom, 18)
+    }
+
+    private var headerSubtitle: String {
+        guard self.client.isActivated, let user = self.client.config.user else {
+            return "Введите регистрационный код, который выдал Николай, чтобы привязать это устройство к сотруднику."
+        }
+        return "\(user.displayName) - \(user.role). Устройство подключено к \(self.client.config.controlPlaneURL)."
+    }
+
+    private var connectionBadge: some View {
+        VStack(alignment: .trailing, spacing: 4) {
+            Text("ONLINE")
+                .font(.caption.weight(.bold))
+                .foregroundStyle(.green)
+            if let heartbeatAt = self.client.config.lastHeartbeatAt {
+                Text("heartbeat: \(heartbeatAt)")
+                    .font(.caption2)
+                    .foregroundStyle(.secondary)
+            }
+        }
+    }
+
+    private var activationView: some View {
+        VStack(alignment: .leading, spacing: 20) {
+            VStack(alignment: .leading, spacing: 8) {
+                Text("Регистрация устройства")
+                    .font(.headline)
+                Text("Код создаётся Николаем в Telegram-боте. После успешной регистрации приложение сохранит device token и будет отправлять heartbeat на сервер.")
+                    .font(.callout)
+                    .foregroundStyle(.secondary)
+            }
+
+            VStack(alignment: .leading, spacing: 10) {
+                Text("Сервер")
+                    .font(.caption.weight(.semibold))
+                    .foregroundStyle(.secondary)
+                TextField("https://starlabagent.pp.ua", text: self.$controlPlaneURL)
+                    .textFieldStyle(.roundedBorder)
+                    .disabled(self.isActivating)
+            }
+
+            VStack(alignment: .leading, spacing: 10) {
+                Text("Registration code")
+                    .font(.caption.weight(.semibold))
+                    .foregroundStyle(.secondary)
+                SecureField("Код от Николая", text: self.$registrationCode)
+                    .textFieldStyle(.roundedBorder)
+                    .disabled(self.isActivating)
+                    .onSubmit { Task { await self.activate() } }
+            }
+
+            if let activationError {
+                Text(activationError)
+                    .font(.callout)
+                    .foregroundStyle(.red)
+                    .padding(.vertical, 2)
+            }
+
+            HStack(spacing: 12) {
+                Button {
+                    Task { await self.activate() }
+                } label: {
+                    if self.isActivating {
+                        ProgressView()
+                            .controlSize(.small)
+                    } else {
+                        Text("Подключить устройство")
+                    }
+                }
+                .buttonStyle(.borderedProminent)
+                .disabled(self.isActivating || self.registrationCode.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
+
+                Button("Сбросить") {
+                    self.registrationCode = ""
+                    self.activationError = nil
+                }
+                .disabled(self.isActivating)
+            }
+
+            Spacer(minLength: 0)
+        }
+        .padding(26)
+    }
+
+    private var chatView: some View {
+        VStack(spacing: 0) {
+            ScrollViewReader { proxy in
+                ScrollView {
+                    LazyVStack(alignment: .leading, spacing: 12) {
+                        self.deviceSummary
+                        ForEach(self.messages) { message in
+                            self.messageBubble(message)
+                                .id(message.id)
+                        }
+                    }
+                    .padding(24)
+                }
+                .onChange(of: self.messages) { _, messages in
+                    if let last = messages.last {
+                        withAnimation(.easeOut(duration: 0.2)) {
+                            proxy.scrollTo(last.id, anchor: .bottom)
+                        }
+                    }
+                }
+            }
+
+            Divider()
+            VStack(alignment: .leading, spacing: 10) {
+                if let chatError {
+                    Text(chatError)
+                        .font(.callout)
+                        .foregroundStyle(.red)
+                }
+                HStack(alignment: .bottom, spacing: 10) {
+                    TextField("Напишите вопрос агенту", text: self.$draft, axis: .vertical)
+                        .textFieldStyle(.roundedBorder)
+                        .lineLimit(1...4)
+                        .disabled(self.isSending)
+                        .onSubmit { Task { await self.send() } }
+                    Button {
+                        Task { await self.send() }
+                    } label: {
+                        if self.isSending {
+                            ProgressView()
+                                .controlSize(.small)
+                        } else {
+                            Image(systemName: "paperplane.fill")
+                        }
+                    }
+                    .buttonStyle(.borderedProminent)
+                    .disabled(self.isSending || self.draft.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty)
+                }
+                HStack {
+                    Button("Сбросить регистрацию") {
+                        self.client.reset()
+                        self.chatError = nil
+                        self.activationError = nil
+                        self.messages = []
+                    }
+                    .buttonStyle(.bordered)
+                    .controlSize(.small)
+                    Spacer()
+                }
+            }
+            .padding(18)
+        }
+    }
+
+    private var deviceSummary: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Text("Привязка")
+                .font(.headline)
+            if let user = self.client.config.user {
+                Text("Пользователь: \(user.displayName) (\(user.role))")
+            }
+            if let agent = self.client.config.agent {
+                Text("Устройство: \(agent.displayName ?? agent.deviceId)")
+                Text("Device ID: \(agent.deviceId)")
+            }
+            if let error = self.client.config.lastHeartbeatError {
+                Text("Последняя ошибка heartbeat: \(error)")
+                    .foregroundStyle(.orange)
+            }
+        }
+        .font(.callout)
+        .padding(14)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .background(Color(nsColor: .controlBackgroundColor))
+        .clipShape(RoundedRectangle(cornerRadius: 10))
+    }
+
+    private func messageBubble(_ message: StarlabChatMessage) -> some View {
+        HStack {
+            if message.sender == .user {
+                Spacer(minLength: 48)
+            }
+            Text(message.text)
+                .font(.callout)
+                .textSelection(.enabled)
+                .padding(.vertical, 10)
+                .padding(.horizontal, 12)
+                .background(message.sender == .user ? Color.accentColor.opacity(0.18) : Color(nsColor: .controlBackgroundColor))
+                .clipShape(RoundedRectangle(cornerRadius: 10))
+                .frame(maxWidth: 520, alignment: message.sender == .user ? .trailing : .leading)
+            if message.sender == .assistant {
+                Spacer(minLength: 48)
+            }
+        }
+    }
+
+    private func activate() async {
+        let code = self.registrationCode.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !code.isEmpty else { return }
+        self.isActivating = true
+        self.activationError = nil
+        do {
+            try await self.client.activate(registrationCode: code, controlPlaneURL: self.controlPlaneURL)
+            self.messages.append(StarlabChatMessage(sender: .assistant, text: "Готово. Устройство привязано, heartbeat запущен, можно общаться с ассистентом."))
+        } catch {
+            self.activationError = error.localizedDescription
+        }
+        self.isActivating = false
+    }
+
+    private func send() async {
+        let text = self.draft.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !text.isEmpty else { return }
+        self.draft = ""
+        self.chatError = nil
+        self.isSending = true
+        self.messages.append(StarlabChatMessage(sender: .user, text: text))
+        do {
+            let answer = try await self.client.ask(text)
+            self.messages.append(StarlabChatMessage(sender: .assistant, text: answer))
+        } catch {
+            self.chatError = error.localizedDescription
+        }
+        self.isSending = false
+    }
+}
diff --git a/apps/macos/Sources/OpenClaw/StarlabDeviceCommandExecutor.swift b/apps/macos/Sources/OpenClaw/StarlabDeviceCommandExecutor.swift
new file mode 100644
index 0000000000..19bea21af5
--- /dev/null
+++ b/apps/macos/Sources/OpenClaw/StarlabDeviceCommandExecutor.swift
@@ -0,0 +1,279 @@
+import AppKit
+import Foundation
+
+struct StarlabDeviceCommandExecution {
+    var status: String
+    var result: [String: Any]
+    var error: String?
+}
+
+@MainActor
+enum StarlabDeviceCommandExecutor {
+    static func execute(_ command: StarlabDeviceCommand) async -> StarlabDeviceCommandExecution {
+        do {
+            switch command.type {
+            case "open_app":
+                return .success(try openApp(command.argsDictionary))
+            case "close_app":
+                return .success(try closeApp(command.argsDictionary))
+            case "open_url":
+                return .success(try openURL(command.argsDictionary))
+            case "open_file":
+                return .success(try openFile(command.argsDictionary))
+            case "list_running_apps":
+                return .success(listRunningApps())
+            case "active_window":
+                return .success(activeWindow())
+            case "screenshot":
+                return .success(try screenshot())
+            case "clipboard_get":
+                return .success(clipboardText())
+            case "clipboard_set":
+                return .success(try setClipboard(command.argsDictionary))
+            case "keyboard_type":
+                return .success(try typeText(command.argsDictionary))
+            case "hotkey":
+                return .success(try pressHotkey(command.argsDictionary))
+            case "mouse_click":
+                return .success(try clickMouse(command.argsDictionary))
+            case "ocr_screen", "openclaw_prompt":
+                return .unsupported("\(command.type) is not supported in this local build yet")
+            default:
+                return .unsupported("Unknown command type: \(command.type)")
+            }
+        } catch {
+            return .failure(error.localizedDescription)
+        }
+    }
+
+    private static func openApp(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        let appName = try requiredString(args, names: ["app", "name", "path", "target"], message: "open_app requires args.app")
+        try runProcess("/usr/bin/open", ["-a", appName])
+        return ["opened": appName]
+    }
+
+    private static func closeApp(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        let appName = try requiredString(args, names: ["app", "name", "process", "processName"], message: "close_app requires args.app")
+        let script = "tell application \"\(escapeAppleScript(appName))\" to quit"
+        try runProcess("/usr/bin/osascript", ["-e", script])
+        return ["closed": appName]
+    }
+
+    private static func openURL(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        let rawURL = try requiredString(args, names: ["url", "target"], message: "open_url requires args.url")
+        guard let url = URL(string: rawURL), NSWorkspace.shared.open(url) else {
+            throw commandError("Unable to open URL: \(rawURL)")
+        }
+        return ["opened": rawURL]
+    }
+
+    private static func openFile(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        let path = try requiredString(args, names: ["path", "file", "target"], message: "open_file requires args.path")
+        let url = URL(fileURLWithPath: path)
+        guard NSWorkspace.shared.open(url) else {
+            throw commandError("Unable to open file: \(path)")
+        }
+        return ["opened": path]
+    }
+
+    private static func listRunningApps() -> [String: Any] {
+        let apps = NSWorkspace.shared.runningApplications
+            .filter { $0.activationPolicy == .regular || $0.localizedName != nil }
+            .prefix(120)
+            .map { app in
+                [
+                    "name": app.localizedName ?? "",
+                    "processId": Int(app.processIdentifier),
+                    "bundleIdentifier": app.bundleIdentifier ?? "",
+                    "isActive": app.isActive,
+                ] as [String: Any]
+            }
+        return ["apps": Array(apps)]
+    }
+
+    private static func activeWindow() -> [String: Any] {
+        guard let app = NSWorkspace.shared.frontmostApplication else {
+            return ["app": NSNull()]
+        }
+        return [
+            "app": [
+                "name": app.localizedName ?? "",
+                "processId": Int(app.processIdentifier),
+                "bundleIdentifier": app.bundleIdentifier ?? "",
+            ],
+        ]
+    }
+
+    private static func screenshot() throws -> [String: Any] {
+        let outputURL = FileManager.default.temporaryDirectory
+            .appendingPathComponent("starlab-openclaw-shot-\(UUID().uuidString).png")
+        try runProcess("/usr/sbin/screencapture", ["-x", "-t", "png", outputURL.path])
+        let data = try Data(contentsOf: outputURL)
+        try? FileManager.default.removeItem(at: outputURL)
+        return [
+            "mimeType": "image/png",
+            "filename": outputURL.lastPathComponent,
+            "base64": data.base64EncodedString(),
+        ]
+    }
+
+    private static func clipboardText() -> [String: Any] {
+        let text = NSPasteboard.general.string(forType: .string) ?? ""
+        return ["text": text]
+    }
+
+    private static func setClipboard(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        let text = stringArg(args, names: ["text", "value", "content"]) ?? ""
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(text, forType: .string)
+        return ["ok": true]
+    }
+
+    private static func typeText(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        let text = try requiredString(args, names: ["text", "value"], message: "keyboard_type requires args.text")
+        _ = try setClipboard(["text": .string(text)])
+        try sendHotkey(["cmd", "v"])
+        return ["typed": text.count, "method": "clipboard-paste"]
+    }
+
+    private static func pressHotkey(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        let keys = normalizedKeys(args["keys"] ?? args["hotkey"] ?? args["combo"])
+        guard !keys.isEmpty else {
+            throw commandError("hotkey requires args.keys")
+        }
+        try sendHotkey(keys)
+        return ["keys": keys]
+    }
+
+    private static func clickMouse(_ args: [String: StarlabJSONValue]) throws -> [String: Any] {
+        guard let x = args["x"]?.doubleValue, let y = args["y"]?.doubleValue else {
+            throw commandError("mouse_click requires numeric args.x and args.y")
+        }
+        let buttonName = args["button"]?.stringValue?.lowercased() ?? "left"
+        let button: CGMouseButton = buttonName == "right" ? .right : .left
+        let down: CGEventType = button == .right ? .rightMouseDown : .leftMouseDown
+        let up: CGEventType = button == .right ? .rightMouseUp : .leftMouseUp
+        let point = CGPoint(x: x, y: y)
+        CGEvent(mouseEventSource: nil, mouseType: down, mouseCursorPosition: point, mouseButton: button)?.post(tap: .cghidEventTap)
+        CGEvent(mouseEventSource: nil, mouseType: up, mouseCursorPosition: point, mouseButton: button)?.post(tap: .cghidEventTap)
+        return ["x": x, "y": y, "button": buttonName]
+    }
+
+    private static func sendHotkey(_ keys: [String]) throws {
+        var flags: CGEventFlags = []
+        var keyName: String?
+        for key in keys.map({ $0.lowercased() }) {
+            switch key {
+            case "cmd", "command", "meta":
+                flags.insert(.maskCommand)
+            case "ctrl", "control":
+                flags.insert(.maskControl)
+            case "alt", "option":
+                flags.insert(.maskAlternate)
+            case "shift":
+                flags.insert(.maskShift)
+            default:
+                keyName = key
+            }
+        }
+        guard let finalKey = keyName, let keyCode = keyCodeMap[finalKey] else {
+            throw commandError("Unsupported hotkey key: \(keyName ?? "none")")
+        }
+        postKey(keyCode, flags: flags, keyDown: true)
+        postKey(keyCode, flags: flags, keyDown: false)
+    }
+
+    private static func postKey(_ keyCode: CGKeyCode, flags: CGEventFlags, keyDown: Bool) {
+        let event = CGEvent(keyboardEventSource: nil, virtualKey: keyCode, keyDown: keyDown)
+        event?.flags = flags
+        event?.post(tap: .cghidEventTap)
+    }
+
+    private static func runProcess(_ executable: String, _ arguments: [String]) throws {
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: executable)
+        process.arguments = arguments
+        let errorPipe = Pipe()
+        process.standardError = errorPipe
+        try process.run()
+        process.waitUntilExit()
+        if process.terminationStatus != 0 {
+            let data = errorPipe.fileHandleForReading.readDataToEndOfFile()
+            let stderr = String(data: data, encoding: .utf8) ?? ""
+            throw commandError(stderr.isEmpty ? "\(executable) exited with \(process.terminationStatus)" : stderr)
+        }
+    }
+
+    private static func requiredString(
+        _ args: [String: StarlabJSONValue],
+        names: [String],
+        message: String
+    ) throws -> String {
+        guard let value = stringArg(args, names: names), !value.isEmpty else {
+            throw commandError(message)
+        }
+        return value
+    }
+
+    private static func stringArg(_ args: [String: StarlabJSONValue], names: [String]) -> String? {
+        for name in names {
+            if let value = args[name]?.stringValue?.trimmingCharacters(in: .whitespacesAndNewlines), !value.isEmpty {
+                return value
+            }
+        }
+        return nil
+    }
+
+    private static func normalizedKeys(_ value: StarlabJSONValue?) -> [String] {
+        switch value {
+        case .array(let values)?:
+            return values.compactMap(\.stringValue).map { $0.trimmingCharacters(in: .whitespacesAndNewlines).lowercased() }.filter { !$0.isEmpty }
+        case .string(let value)?:
+            return value
+                .split { $0 == "+" || $0 == "," || $0 == " " }
+                .map { String($0).trimmingCharacters(in: .whitespacesAndNewlines).lowercased() }
+                .filter { !$0.isEmpty }
+        default:
+            return []
+        }
+    }
+
+    private static func escapeAppleScript(_ value: String) -> String {
+        value.replacingOccurrences(of: "\\", with: "\\\\")
+            .replacingOccurrences(of: "\"", with: "\\\"")
+    }
+
+    private static func commandError(_ message: String) -> NSError {
+        NSError(domain: "StarlabDeviceCommand", code: 1, userInfo: [NSLocalizedDescriptionKey: message])
+    }
+
+    private static let keyCodeMap: [String: CGKeyCode] = [
+        "a": 0, "s": 1, "d": 2, "f": 3, "h": 4, "g": 5, "z": 6, "x": 7, "c": 8, "v": 9,
+        "b": 11, "q": 12, "w": 13, "e": 14, "r": 15, "y": 16, "t": 17, "1": 18, "2": 19,
+        "3": 20, "4": 21, "6": 22, "5": 23, "=": 24, "9": 25, "7": 26, "-": 27, "8": 28,
+        "0": 29, "]": 30, "o": 31, "u": 32, "[": 33, "i": 34, "p": 35, "enter": 36,
+        "return": 36, "l": 37, "j": 38, "'": 39, "k": 40, ";": 41, "\\": 42, ",": 43,
+        "/": 44, "n": 45, "m": 46, ".": 47, "tab": 48, "space": 49, "`": 50, "delete": 51,
+        "esc": 53, "escape": 53, "left": 123, "right": 124, "down": 125, "up": 126,
+    ]
+}
+
+private extension StarlabDeviceCommand {
+    var argsDictionary: [String: StarlabJSONValue] {
+        self.args ?? [:]
+    }
+}
+
+private extension StarlabDeviceCommandExecution {
+    static func success(_ result: [String: Any]) -> StarlabDeviceCommandExecution {
+        StarlabDeviceCommandExecution(status: "succeeded", result: result, error: nil)
+    }
+
+    static func failure(_ error: String) -> StarlabDeviceCommandExecution {
+        StarlabDeviceCommandExecution(status: "failed", result: [:], error: error)
+    }
+
+    static func unsupported(_ error: String) -> StarlabDeviceCommandExecution {
+        StarlabDeviceCommandExecution(status: "unsupported", result: [:], error: error)
+    }
+}
