# Company Control Plane Windows configuration

# HTTP API
HOST=127.0.0.1
PORT=3099

# Initial owner Telegram id. Set this to Nikolay's Telegram numeric user id
# before first launch, or set it through http://127.0.0.1:3099/setup.
BOOTSTRAP_OWNER_TELEGRAM_ID=dev-nikolay

# Token analytics reports are sent only to this Telegram id.
TOKEN_USAGE_REPORT_TELEGRAM_ID=984834133

# Non-secret Metricon API base URL. Access tokens and other secrets should be
# saved through the setup wizard so they are encrypted at rest.
METRICON_BASE_URL=http://85.239.49.208:8080

# Backward-compatible legacy names are still accepted by the service:
# KICKIDLER_BASE_URL=

# Runtime paths on Windows production install
CONTROL_PLANE_DATA_FILE=C:\ProgramData\CompanyControlPlane\control-plane.json

# Optional override for encrypted setup files:
# CONTROL_PLANE_CONFIG_DIR=C:\ProgramData\CompanyControlPlane

# Claude model policy is enforced by the setup service at runtime:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENCLAW_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
#
# Optional token usage ingest protection should be saved through the setup
# wizard as TOKEN_USAGE_INGEST_TOKEN, not written here.
