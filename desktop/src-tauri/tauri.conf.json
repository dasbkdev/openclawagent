{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAI",
  "version": "0.1.1",
  "identifier": "ua.pp.starlabagent.sai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SAI",
        "label": "main",
        "width": 1160,
        "height": 780,
        "minWidth": 680,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://main-server.taild4d010.ts.net/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5OENCNjBCREI5NDhFNzYKUldSMmpwVGJDN2FNK1pYRVRvTlJhMEttUU4xNVozcFU1bXY3aEFYcGhZN0NjcExQREIweE1rV00K"
    }
  }
}
